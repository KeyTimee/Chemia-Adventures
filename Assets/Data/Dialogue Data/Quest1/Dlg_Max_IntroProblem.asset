  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 851d23c17f74e5b4abf18cfbb866d674, type: 3}
  m_Name: Dlg_Max_IntroProblem
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Max
    speakerPortrait: {fileID: 21300000, guid: 9601b91ff7cdd494ab692895ec78070f, type: 3}
    sentence: Oh, kamu pasti utusan dari markas penelitian! Kenalkan, aku Max. Syukurlah
      kalian cepat datang.
  - speakerName: Max
    speakerPortrait: {fileID: 21300000, guid: 9601b91ff7cdd494ab692895ec78070f, type: 3}
    sentence: Lihatlah lahan pertanianku ini... beberapa hari terakhir tanaman di
      bagian tertentu mendadak layu dan pertumbuhannya terhambat, padahal jadwal
      penyiramannya sama.
  - speakerName: Max
    speakerPortrait: {fileID: 21300000, guid: 9601b91ff7cdd494ab692895ec78070f, type: 3}
    sentence: Bisakah kamu memeriksa kondisi tanah di keempat petak lahanku? Aku
      benar-benar bingung apa penyebabnya.
