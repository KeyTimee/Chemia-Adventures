  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 851d23c17f74e5b4abf18cfbb866d674, type: 3}
  m_Name: Dlg_Clara_FinalEducation
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Clara
    speakerPortrait: {fileID: 7317794693344909607, guid: 9e533e70bb2db22458af0ee19c41e219, type: 3}
    sentence: Wah, luar biasa! Bau pesing yang menyengat langsung hilang dan sapi-sapi
      kembali tenang!
  - speakerName: Altord
    speakerPortrait: {fileID: 21300000, guid: b17f78e586f718e48bb375007cdf5730, type: 3}
    sentence: Asam asetat encer mengikat gas amonia basa menjadi garam amonium asetat
      yang netral dan tidak menguap lagi, Clara.
  - speakerName: Altord
    speakerPortrait: {fileID: 21300000, guid: b17f78e586f718e48bb375007cdf5730, type: 3}
    sentence: Supaya gas amonia tidak menumpuk lagi, kotoran padat dan saluran urine
      sapi sebaiknya dipisahkan dan dibersihkan secara rutin setiap hari.
  - speakerName: Clara
    speakerPortrait: {fileID: 7317794693344909607, guid: 9e533e70bb2db22458af0ee19c41e219, type: 3}
    sentence: Ilmu yang sangat bermanfaat! Aku akan langsung menerapkannya bersama
      Paman Max. Ini 400 Quark sebagai tanda terima kasih kami!
