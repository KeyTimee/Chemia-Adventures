  m_Script: {fileID: 11500000, guid: 851d23c17f74e5b4abf18cfbb866d674, type: 3}
  m_Name: Dlg_JohnQ2_ApprovalDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: John
    speakerPortrait: {fileID: 21300000, guid: f3ed164c7e3f036469dfca003564f3ac, type: 3}
    sentence: "Reaksi NH3 + CH3COOH \u2192 CH3COONH4 berjalan sempurna! Larutan Amonium
      Asetat ini netral (pH 7,0) dan tidak lagi mengeluarkan uap amonia menyengat."
  - speakerName: John
    speakerPortrait: {fileID: 21300000, guid: f3ed164c7e3f036469dfca003564f3ac, type: 3}
    sentence: Formula larutan asam asetat encermu sudah aman digunakan di sekitar
      hewan ternak.
  - speakerName: John
    speakerPortrait: {fileID: 21300000, guid: f3ed164c7e3f036469dfca003564f3ac, type: 3}
    sentence: Kembalilah ke Peternakan dan semprotkan Asam Asetat Encer pada 3 titik
      tumpukan kotoran di kandang sapi Max!
