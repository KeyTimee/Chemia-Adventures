  m_Script: {fileID: 11500000, guid: 851d23c17f74e5b4abf18cfbb866d674, type: 3}
  m_Name: Dlg_JohnQ2_BriefingClara
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: John
    speakerPortrait: {fileID: 21300000, guid: f3ed164c7e3f036469dfca003564f3ac, type: 3}
    sentence: Altord, pas sekali kamu datang! Paman Max baru mengirim kabar dari
      Peternakan di selatan.
  - speakerName: John
    speakerPortrait: {fileID: 21300000, guid: f3ed164c7e3f036469dfca003564f3ac, type: 3}
    sentence: Keponakannya, Clara, sedang berkunjung dan mengeluhkan bau pesing sangat
      tajam di sekitar kandang sapi hingga membuat mata perih.
  - speakerName: John
    speakerPortrait: {fileID: 21300000, guid: f3ed164c7e3f036469dfca003564f3ac, type: 3}
    sentence: Bawalah Detektor Gas (Gas Detector) ini untuk mengecek kadar gas dan
      pH udara di sekitar kandang sapi Max. Temui Clara di sana!
