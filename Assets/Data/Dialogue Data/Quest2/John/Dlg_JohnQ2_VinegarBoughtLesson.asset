  m_Script: {fileID: 11500000, guid: 851d23c17f74e5b4abf18cfbb866d674, type: 3}
  m_Name: Dlg_JohnQ2_VinegarBoughtLesson
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: John
    speakerPortrait: {fileID: 21300000, guid: f3ed164c7e3f036469dfca003564f3ac, type: 3}
    sentence: Bagus! Kamu berhasil mendapatkan Biang Cuka Pekat dari warga desa.
  - speakerName: John
    speakerPortrait: {fileID: 21300000, guid: f3ed164c7e3f036469dfca003564f3ac, type: 3}
    sentence: Ingat, asam asetat pekat terlalu korosif jika langsung disemprotkan
      ke kandang. Kita harus mengencerkannya dengan Air Netral di Meja Eksperimen
      terlebih dahulu.
  - speakerName: John
    speakerPortrait: {fileID: 21300000, guid: f3ed164c7e3f036469dfca003564f3ac, type: 3}
    sentence: Sekalian larutkan Sampel Kotoran Sapi dengan Air Netral, lalu uji reaksi
      keduanya di Meja Eksperimen sampai terbentuk larutan Amonium Asetat yang netral!
